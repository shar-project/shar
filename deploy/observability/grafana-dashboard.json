{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Ready targets",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(up{job=~\"shar.*\"})", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Successful protocol operations / second",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(shar_challenges_issued_total[5m]))",
          "legendFormat": "issued",
          "refId": "A"
        },
        {
          "expr": "sum(rate(shar_challenges_redeemed_total[5m]))",
          "legendFormat": "redeemed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(shar_site_verifications_total[5m]))",
          "legendFormat": "site verified",
          "refId": "C"
        },
        {
          "expr": "sum(rate(shar_fallback_completions_total[5m]))",
          "legendFormat": "fallback",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean successful challenge duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(shar_challenge_engine_duration_seconds_total[5m])) / clamp_min(sum(rate(shar_challenges_issued_total[5m])), 0.001)",
          "legendFormat": "engine",
          "refId": "A"
        },
        {
          "expr": "sum(rate(shar_challenge_handler_duration_seconds_total[5m])) / clamp_min(sum(rate(shar_challenges_issued_total[5m])), 0.001)",
          "legendFormat": "handler",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dropped audit events / second",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(shar_audit_events_dropped_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Privacy-safe request observations",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_name=\"shar\",observation_version=\"request-observation-v1\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["shar", "privacy-safe"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Shar Operations",
  "uid": "shar-operations",
  "version": 1
}
