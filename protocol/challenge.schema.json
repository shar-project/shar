{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar.dev/schema/v1/challenge.json",
  "title": "Shar challenge exchange",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "site_key", "action", "origin"],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-shar-maxUtf8Bytes": 128,
          "x-shar-noControlCharacters": true
        },
        "site_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-shar-maxUtf8Bytes": 256,
          "x-shar-noControlCharacters": true
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-shar-maxUtf8Bytes": 128,
          "x-shar-noControlCharacters": true
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 512,
          "x-shar-maxUtf8Bytes": 512,
          "x-shar-noControlCharacters": true
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-shar-maxUtf8Bytes": 64,
          "x-shar-noControlCharacters": true
        },
        "session_binding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-shar-maxUtf8Bytes": 256,
          "x-shar-noControlCharacters": true
        },
        "trust_token": { "$ref": "trust-credit.json#/$defs/token" }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "seed", "rounds", "triangles", "samples"],
      "properties": {
        "version": { "const": "render-v1" },
        "seed": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "rounds": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "triangles": { "type": "integer", "minimum": 1, "maximum": 512 },
        "samples": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "time_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "modulus_id", "modulus", "input", "iterations"],
      "properties": {
        "version": { "const": "rsw-v1" },
        "modulus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-shar-maxUtf8Bytes": 64,
          "x-shar-noControlCharacters": true
        },
        "modulus": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "input": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "iterations": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["none", "host"] } }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "methods"],
      "properties": {
        "available": { "type": "boolean" },
        "methods": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "available": { "const": true } } },
          "then": {
            "properties": { "methods": { "type": "array", "minItems": 1 } }
          },
          "else": {
            "properties": { "methods": { "type": "array", "maxItems": 0 } }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "quote",
        "render",
        "time_lock",
        "presence",
        "fallback"
      ],
      "properties": {
        "token": { "type": "string", "pattern": "^shr1_[A-Za-z0-9_-]+$" },
        "quote": { "$ref": "work-quote.json" },
        "render": { "$ref": "#/$defs/render" },
        "time_lock": { "$ref": "#/$defs/time_lock" },
        "presence": { "$ref": "#/$defs/presence" },
        "fallback": { "$ref": "#/$defs/fallback" },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-shar-maxUtf8Bytes": 64,
          "x-shar-noControlCharacters": true
        },
        "trust": { "$ref": "trust-credit.json#/$defs/plan" }
      }
    }
  }
}
