{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar.dev/schema/v1/redeem.json",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "time_lock", "rendering"],
      "properties": {
        "token": { "type": "string", "pattern": "^shr1_[A-Za-z0-9_-]+$" },
        "time_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output"],
          "properties": {
            "output": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
          }
        },
        "rendering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "backend"],
          "properties": {
            "digest": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
            "backend": { "enum": ["webgpu", "webgl2", "css"] },
            "css_commitment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "digest"],
              "properties": {
                "version": { "const": "css-transcript-v1" },
                "digest": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                }
              }
            }
          }
        },
        "trust_blinded": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tier",
        "time_lock_iterations",
        "render_rounds",
        "rendering_backend",
        "completed_at"
      ],
      "properties": {
        "version": { "const": "work-receipt-v1" },
        "tier": { "type": "integer", "minimum": 0, "maximum": 32 },
        "time_lock_iterations": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "render_rounds": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "rendering_backend": { "enum": ["webgpu", "webgl2", "css"] },
        "completed_at": { "type": "integer", "minimum": 0 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "expires_at", "receipt"],
      "properties": {
        "token": { "type": "string", "pattern": "^shr1_[A-Za-z0-9_-]+$" },
        "expires_at": { "type": "integer", "minimum": 0 },
        "receipt": { "$ref": "#/$defs/receipt" },
        "trust_evaluation": {
          "$ref": "trust-evaluation.json"
        }
      }
    }
  }
}
