{
  "name": "@shar/server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shar-project/shar.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "worker": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "worker": "./dist/browser.js",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./trust": {
      "types": "./dist/trust.d.ts",
      "browser": "./dist/trust.js",
      "worker": "./dist/trust.js",
      "import": "./dist/trust.js",
      "default": "./dist/trust.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.2.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3",
    "deno": ">=2"
  }
}
